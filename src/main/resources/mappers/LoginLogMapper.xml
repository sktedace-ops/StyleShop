<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.vscodeshop.mapper.LoginLogMapper">

    <resultMap id="LoginLogResultMap" type="com.example.vscodeshop.model.LoginLog">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="loginTime" column="login_time"/>
        <result property="status" column="status"/>
        <result property="message" column="message"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.vscodeshop.model.LoginLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO login_logs (username, login_time, status, message)
        VALUES (#{username}, #{loginTime}, #{status}, #{message})
    </insert>

    <select id="findAll" resultMap="LoginLogResultMap">
        SELECT id, username, login_time, status, message
        FROM login_logs
        ORDER BY login_time DESC, id DESC
    </select>

</mapper>
