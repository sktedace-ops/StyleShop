<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.vscodeshop.mapper.CategoryMapper">
    <select id="findAll" resultType="com.example.vscodeshop.model.Category">
        SELECT id, name FROM categories ORDER BY id
    </select>
    <select id="findById" resultType="com.example.vscodeshop.model.Category">
        SELECT id, name FROM categories WHERE id = #{id}
    </select>
    <select id="findByName" resultType="com.example.vscodeshop.model.Category">
        SELECT id, name FROM categories WHERE name = #{name} LIMIT 1
    </select>
    <insert id="insert" parameterType="com.example.vscodeshop.model.Category"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name) VALUES (#{name})
    </insert>
    <update id="update" parameterType="com.example.vscodeshop.model.Category">
        UPDATE categories SET name = #{name} WHERE id = #{id}
    </update>
    <delete id="deleteById">
        DELETE FROM categories WHERE id = #{id}
    </delete>
</mapper>
